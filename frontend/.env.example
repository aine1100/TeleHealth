# Frontend env — for SINGLE Render web service leave REACT_APP_API_URL unset.
# The built app is served by Express on the same host as /api and /socket.io.

# Only set this if you intentionally split frontend and backend on different hosts:
# REACT_APP_API_URL=https://other-api.example.com

# Local CRA: HTTP by default. Use `npm run start:https` when you need camera on LAN.
# HTTPS=false
# HOST=0.0.0.0
# PORT=3000
# REACT_APP_PROXY_TARGET=http://127.0.0.1:5000

ESLINT_NO_DEV_ERRORS=true
