# Public URLs — SINGLE service
PLATFORM_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5000

APP_HOST_PORT=5000
MONGO_HOST_PORT=27017

# Auth / seed
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE=7d
NODE_ENV=production
MOCK_PAYMENTS=true

# Seed on container start (admin, clinic, doctors, patients, lab, insurance, pharmacy)
SEED_ON_BOOT=true
ADMIN_EMAIL=admin@alivehealth.ug
ADMIN_PASSWORD=Admin@123
DEMO_PASSWORD=Demo@123

# Cloudflare R2 — use the public r2.dev (or custom domain) URL for browser access
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=afyalink
R2_PUBLIC_URL=https://pub-ae342959899f40b29244cada8abbbafe.r2.dev

# Web Push (medicine reminders on phone / browser)
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@alivehealth.ug

EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@alivehealth.ug
