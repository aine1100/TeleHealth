# Public URLs — SINGLE service
PLATFORM_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5000

APP_HOST_PORT=5000
MONGO_HOST_PORT=27017

# Auth / seed
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE=7d
NODE_ENV=production
MOCK_PAYMENTS=true

# Seed on container start (admin, clinic, doctors, patients, lab, insurance, pharmacy)
SEED_ON_BOOT=true
ADMIN_EMAIL=admin@alivehealth.ug
ADMIN_PASSWORD=Admin@123
DEMO_PASSWORD=Demo@123

EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@alivehealth.ug
